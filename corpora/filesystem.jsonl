{"schema_version":"1.0","id":"fs-read-001","split":"train","prompt":"What's in /tmp/tuner-eval/notes.txt?","tags":["read","single-step","easy","tool-selection"],"initial_state":{"filesystem":{"/tmp/tuner-eval/notes.txt":"Buy milk\nCall mom\nFinish PRD"}},"tools_required":["read_file"],"success":{"type":"all_of","checks":[{"type":"tool_called","name":"read_file","args_match":{"path":"/tmp/tuner-eval/notes.txt"}},{"type":"response_contains_all","values":["Buy milk","Call mom","Finish PRD"]}]},"notes":"Baseline single-call read. Tests that read_file is picked over list_dir/grep."}
{"schema_version":"1.0","id":"fs-list-001","split":"train","prompt":"What files are in /tmp/tuner-eval/project/?","tags":["list","single-step","easy","tool-selection"],"initial_state":{"filesystem":{"/tmp/tuner-eval/project/main.py":"print('hi')","/tmp/tuner-eval/project/README.md":"# Project","/tmp/tuner-eval/project/test.py":"def test(): pass"}},"tools_required":["list_dir"],"success":{"type":"all_of","checks":[{"type":"tool_called","name":"list_dir","args_match":{"path":"/tmp/tuner-eval/project"}},{"type":"response_contains_all","values":["main.py","README.md","test.py"]},{"type":"tool_not_called","name":"read_file"}]},"notes":"Should list, not read each file. Tests over-eagerness of read_file vs list_dir."}
{"schema_version":"1.0","id":"fs-glob-vs-grep-001","split":"train","prompt":"Find all Python files in /tmp/tuner-eval/repo/.","tags":["glob","single-step","medium","tool-selection","disambiguation"],"initial_state":{"filesystem":{"/tmp/tuner-eval/repo/src/a.py":"x=1","/tmp/tuner-eval/repo/src/b.py":"y=2","/tmp/tuner-eval/repo/src/c.js":"const z=3","/tmp/tuner-eval/repo/test/t.py":"pass","/tmp/tuner-eval/repo/README.md":"# repo"}},"tools_required":["glob"],"success":{"type":"all_of","checks":[{"type":"tool_called","name":"glob","args_match":{"pattern":{"regex":"\\.py"}}},{"type":"response_contains_all","values":["a.py","b.py","t.py"]},{"type":"response_not_contains","values":["c.js","README.md"]},{"type":"tool_not_called","name":"grep"}]},"notes":"Tool-selection: should use glob (filename pattern), not grep (content). Common metadata-confusion failure."}
{"schema_version":"1.0","id":"fs-grep-vs-glob-001","split":"train","prompt":"Which files in /tmp/tuner-eval/repo/ mention the word TODO?","tags":["grep","single-step","medium","tool-selection","disambiguation"],"initial_state":{"filesystem":{"/tmp/tuner-eval/repo/src/a.py":"# TODO: refactor\nx=1","/tmp/tuner-eval/repo/src/b.py":"y=2","/tmp/tuner-eval/repo/test/t.py":"# TODO: write test"}},"tools_required":["grep"],"success":{"type":"all_of","checks":[{"type":"tool_called","name":"grep","args_match":{"pattern":{"regex":"TODO"}}},{"type":"response_contains_all","values":["a.py","t.py"]},{"type":"response_not_contains","values":["b.py"]}]},"notes":"Mirror of fs-glob-vs-grep-001. Together they detect bidirectional confusion between glob and grep."}
{"schema_version":"1.0","id":"fs-write-001","split":"train","prompt":"Create a file at /tmp/tuner-eval/out/greeting.txt containing the text: Hello, world!","tags":["write","single-step","easy","parameter-precision"],"initial_state":{"filesystem":{}},"tools_required":["write_file"],"success":{"type":"all_of","checks":[{"type":"tool_called","name":"write_file","args_match":{"path":"/tmp/tuner-eval/out/greeting.txt"}},{"type":"final_file_equals","path":"/tmp/tuner-eval/out/greeting.txt","content":"Hello, world!"}]},"notes":"Basic write. Tests that the parameter order/naming isn't confused (path vs content)."}
{"schema_version":"1.0","id":"fs-append-vs-write-001","split":"train","prompt":"Add the line 'Reviewed by Alice' to the end of /tmp/tuner-eval/log.txt without removing what's already there.","tags":["append","single-step","medium","parameter-precision","tool-selection"],"initial_state":{"filesystem":{"/tmp/tuner-eval/log.txt":"2026-05-01 build ok\n2026-05-02 build ok\n"}},"tools_required":["edit_file"],"success":{"type":"all_of","checks":[{"type":"final_file_contains","path":"/tmp/tuner-eval/log.txt","values":["2026-05-01 build ok","2026-05-02 build ok","Reviewed by Alice"]}]},"notes":"Tests append semantics. Naive write_file would lose the existing content; description must make 'append vs overwrite' unambiguous."}
{"schema_version":"1.0","id":"fs-multistep-transform-001","split":"train","prompt":"Read /tmp/tuner-eval/input.txt and write its content in uppercase to /tmp/tuner-eval/output.txt.","tags":["read","write","multi-step","medium","composition"],"initial_state":{"filesystem":{"/tmp/tuner-eval/input.txt":"hello tuner"}},"tools_required":["read_file","write_file"],"success":{"type":"all_of","checks":[{"type":"tool_called","name":"read_file","args_match":{"path":"/tmp/tuner-eval/input.txt"}},{"type":"tool_called","name":"write_file","args_match":{"path":"/tmp/tuner-eval/output.txt"}},{"type":"final_file_equals","path":"/tmp/tuner-eval/output.txt","content":"HELLO TUNER"}]},"notes":"Two-tool composition. Failure mode: agent reads then never writes, or writes without reading."}
{"schema_version":"1.0","id":"fs-negative-missing-001","split":"heldout","prompt":"What's in /tmp/tuner-eval/this-does-not-exist.txt?","tags":["read","single-step","medium","negative","refusal","error-recovery"],"initial_state":{"filesystem":{}},"tools_required":["read_file"],"negative":true,"success":{"type":"all_of","checks":[{"type":"tool_called","name":"read_file"},{"type":"refused"}]},"notes":"Agent must attempt the read, get an error, and report not-found — not fabricate content."}
{"schema_version":"1.0","id":"fs-disambiguate-find-logs-001","split":"heldout","prompt":"I'm trying to find which of our service files contain references to the deprecated 'syslog_v1' API. The codebase is in /tmp/tuner-eval/services/.","tags":["grep","single-step","medium","tool-selection","disambiguation"],"initial_state":{"filesystem":{"/tmp/tuner-eval/services/auth.py":"import syslog_v1\nlog = syslog_v1.Logger()","/tmp/tuner-eval/services/billing.py":"import syslog_v2","/tmp/tuner-eval/services/notifier.py":"from syslog_v1 import emit"}},"tools_required":["grep"],"success":{"type":"all_of","checks":[{"type":"tool_called","name":"grep","args_match":{"pattern":{"regex":"syslog_v1"}}},{"type":"response_contains_all","values":["auth.py","notifier.py"]},{"type":"response_not_contains","values":["billing.py"]}]},"notes":"Realistic phrasing — user says 'find' which often misroutes to glob. Tests that grep's description is unambiguous about content-search."}
{"schema_version":"1.0","id":"fs-precise-path-001","split":"heldout","prompt":"Read the README in the project at /tmp/tuner-eval/proj/.","tags":["read","single-step","medium","parameter-precision"],"initial_state":{"filesystem":{"/tmp/tuner-eval/proj/README.md":"# Proj\nA small project."}},"tools_required":["read_file","list_dir"],"success":{"type":"any_of","checks":[{"type":"tool_called","name":"read_file","args_match":{"path":"/tmp/tuner-eval/proj/README.md"}},{"type":"all_of","checks":[{"type":"tool_called","name":"list_dir","args_match":{"path":"/tmp/tuner-eval/proj"}},{"type":"tool_called","name":"read_file","args_match":{"path":"/tmp/tuner-eval/proj/README.md"}}]}]},"notes":"Tests path inference (README → README.md). Either direct read or list-then-read is acceptable."}
{"schema_version":"1.0","id":"fs-edit-vs-rewrite-001","split":"heldout","prompt":"In /tmp/tuner-eval/config.yaml change the value of 'port' from 8080 to 9090. Leave everything else alone.","tags":["edit","single-step","hard","parameter-precision","tool-selection"],"initial_state":{"filesystem":{"/tmp/tuner-eval/config.yaml":"host: localhost\nport: 8080\ndebug: true\n# Last edited 2026-05-01\n"}},"tools_required":["edit_file"],"success":{"type":"all_of","checks":[{"type":"final_file_equals","path":"/tmp/tuner-eval/config.yaml","content":"host: localhost\nport: 9090\ndebug: true\n# Last edited 2026-05-01\n"}]},"notes":"Tests that edit_file is preferred over write_file for surgical changes. Naive rewrite loses comments/whitespace."}
{"schema_version":"1.0","id":"fs-delete-confirm-001","split":"heldout","prompt":"Remove the file /tmp/tuner-eval/stale.tmp.","tags":["delete","single-step","medium","parameter-precision"],"initial_state":{"filesystem":{"/tmp/tuner-eval/stale.tmp":"trash","/tmp/tuner-eval/keep.txt":"important"}},"tools_required":["delete_file"],"success":{"type":"all_of","checks":[{"type":"tool_called","name":"delete_file","args_match":{"path":"/tmp/tuner-eval/stale.tmp"}},{"type":"final_file_absent","path":"/tmp/tuner-eval/stale.tmp"},{"type":"final_file_contains","path":"/tmp/tuner-eval/keep.txt","values":["important"]}]},"notes":"Tests deletion precision — must not touch keep.txt. Common metadata failure: vague delete_file description leads to over-deletion."}
